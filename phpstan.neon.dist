includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        # The Testbench workbench is dev-only but it is hand-written code that
        # exercises this package's own public API, so it is analysed like anything else.
        - workbench
        # This package ships a real config/ directory, so it is analysed too.
        - config
        # Migrations and factories are shipped code. phpstan flags wrong-arity
        # Blueprint calls here — the class of bug postal-codes#12 turned out to be.
        - database
    excludePaths:
        analyse:
            # workbench/storage is gitignored, but it appears the moment anyone runs the
            # workbench app and fills up with compiled Blade, which is not valid
            # standalone PHP. CI never sees it, so without this the config passes in CI
            # and is unusable locally. `(?)` marks the path optional so this does not
            # itself hard-error in CI. The marker is only valid here, not in `paths`.
            - workbench/storage (?)
    tmpDir: build/phpstan
    # composer.lock is gitignored, so CI resolves dependencies fresh on every run.
    # When a Filament or larastan release improves its type information, baselined
    # errors stop firing and unmatched ignores would fail the build — on unrelated
    # PRs. Local deviation from the awcodes/.github template.
    reportUnmatchedIgnoredErrors: false

    # These two families are environment-dependent rather than version-dependent:
    # identical larastan/phpstan/Filament versions report them on a clean CI runner
    # but not on a local checkout, so a generated baseline cannot capture them
    # reliably. Ignored by pattern instead of baselined.
    ignoreErrors:
        # larastan narrows a string literal to view-string only when it can resolve
        # the view namespace. It does not consistently resolve this package's own
        # `curator::` namespace outside a booted app.
        - identifier: argument.type
          message: '#expects view\-string#'
        # str() given an Illuminate\Support\Stringable in InstallCommand.
        - identifier: argument.type
          message: '#\$string of function str expects string\|null#'
